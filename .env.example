# Copy to .env (never committed) or export in your shell. Empty values = sample mode (DuckDB, no keys).
ZETARIS_MODE=
ZETARIS_JDBC_URL=
ZETARIS_JDBC_JAR=
ZETARIS_JDBC_DRIVER_CLASS=
ZETARIS_USER=
ZETARIS_PASSWORD=
# Meterless Nightshift = the primary AI provider (OpenAI-compatible local runtime). NVIDIA Nemotron is reached THROUGH it.
# The NVIDIA key goes in Nightshift's Providers tab, not here. The runtime token comes from the Nightshift Console.
METERLESS_BASE_URL=
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=
# Declared fallback only (LLM_PROVIDER=nim): direct NVIDIA NIM. Never used unless LLM_PROVIDER=nim is set.
LLM_PROVIDER=
NVIDIA_API_KEY=
SAMPLE_MODE=

# PORT=8000   (the API port; the image exposes 8000)
# HOST=127.0.0.1   (bind address; default loopback, the image sets 0.0.0.0)
